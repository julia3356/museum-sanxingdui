# Local equivalent of Tencent Cloud Function environment variables for askGuide.
# Copy this file to .env and fill the real secrets locally.

# Provider selection: deepseek, kimi, or custom via AI_API_BASE_URL/AI_MODEL/AI_API_KEY.
AI_PROVIDER=deepseek

# DeepSeek defaults copied from release/wechat-miniprogram/cloudfunctions/askGuide.
DEEPSEEK_API_KEY=

# Kimi provider, optional.
KIMI_API_KEY=

# Optional generic override. If set, AI_API_KEY is used when the provider-specific key is absent.
AI_API_KEY=
AI_MODEL=
AI_API_BASE_URL=

# Local behavior.
LOCAL_ASK_GUIDE_PORT=8787
LOCAL_DAILY_LIMIT=10
DEBUG_AI_ERRORS=0

# Optional Memory service lookup, matching the cloud function env names.
MEMORY_ENABLED=0
MEMORY_API_BASE_URL=
MEMORY_API_KEY=
MEMORY_AGENT_ID=sanxingdui-guide
MEMORY_TIMEOUT_MS=3000
MEMORY_TOP_K=5
MEMORY_TLS_REJECT_UNAUTHORIZED=1
